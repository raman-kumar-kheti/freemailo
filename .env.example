# MailHive - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# GENERAL
# ============================================================================
NODE_ENV=production
APP_NAME=MailHive
APP_URL=https://mail.example.com
API_URL=https://api.mail.example.com

# ============================================================================
# POSTGRESQL
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mailhive
POSTGRES_USER=mailhive
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ============================================================================
# JWT / AUTH
# ============================================================================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# MAIL SETTINGS
# ============================================================================
MAIL_HOSTNAME=mail.example.com
MAIL_DOMAIN=example.com
POSTFIX_HOST=postfix
POSTFIX_SUBMISSION_PORT=587
DOVECOT_HOST=dovecot
DOVECOT_IMAP_PORT=993
DOVECOT_MASTER_USER=mailhive_master
DOVECOT_MASTER_PASSWORD=CHANGE_ME_DOVECOT_MASTER_PASSWORD
VMAIL_UID=5000
VMAIL_GID=5000
MESSAGE_SIZE_LIMIT=26214400

# ============================================================================
# RSPAMD
# ============================================================================
RSPAMD_HOST=rspamd
RSPAMD_PORT=11333
RSPAMD_PASSWORD=CHANGE_ME_RSPAMD_PASSWORD
RSPAMD_WEB_PORT=11334

# ============================================================================
# TLS / CERTIFICATES
# ============================================================================
TLS_CERT_PATH=/etc/ssl/certs/mail.crt
TLS_KEY_PATH=/etc/ssl/private/mail.key
LETSENCRYPT_EMAIL=admin@example.com

# ============================================================================
# ADMIN
# ============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ============================================================================
# ROUNDCUBE (Phase 1 only)
# ============================================================================
ROUNDCUBE_PORT=8080
ROUNDCUBE_DEFAULT_HOST=ssl://dovecot
ROUNDCUBE_SMTP_SERVER=postfix

# ============================================================================
# OBSERVABILITY
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Mail API verifies TLS by default. For a private CA, set NODE_EXTRA_CA_CERTS
# to the CA bundle mounted into the API container; keep verification enabled.
MAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_TLS_SERVERNAME=mail.example.com
COOKIE_SECURE=true
# Optional provisioning storage roots (container defaults shown)
VMAIL_ROOT=/var/vmail
DKIM_ROOT=/var/lib/rspamd/dkim
