# Production Compose settings. Copy to .env and replace every example value.
# See docs/deployment-runbook.md. Never use .env.dev on a public host.
# Allowed browser origins (comma-separated). Set your exact production domain(s).
APP_URL=https://mail.example.com
MAIL_HOSTNAME=mail.example.com
MAIL_DOMAIN=example.com

# Current Postfix/Dovecot SQL maps expect this database/user name.
POSTGRES_DB=freemailo
POSTGRES_USER=freemailo
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Generate distinct secrets, for example with openssl rand -hex 32.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RSPAMD_PASSWORD=CHANGE_ME_RSPAMD_PASSWORD
DOVECOT_MASTER_USER=freemailo_master
DOVECOT_MASTER_PASSWORD=CHANGE_ME_DOVECOT_MASTER_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECURE=true
MAIL_TLS_REJECT_UNAUTHORIZED=true

# Explicit proxy IPs/CIDRs only; proxy must overwrite forwarded headers.
# Leave blank for direct requests. Do not use a trust-all value.
TRUST_PROXY=

# Certificates: install certs/mail.crt and certs/mail.key on the host.
# Containers use /etc/ssl/mail/mail.crt and /etc/ssl/mail/mail.key.
# For a private CA, add NODE_EXTRA_CA_CERTS and its read-only mount to Compose.
# MAIL_TLS_SERVERNAME is supplied from MAIL_HOSTNAME by Compose.
# Bootstrap ADMIN_EMAIL/ADMIN_PASSWORD via exported environment, not this file.
