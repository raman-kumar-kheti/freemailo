# =============================================================================
# MailHive – Postfix main.cf
# =============================================================================

# General
smtpd_banner = $myhostname ESMTP MailHive
biff = no
disable_vrfy_command = yes
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6
maillog_file = /dev/stdout

# Hostname (overridden by entrypoint)
myhostname = MAIL_HOSTNAME_PLACEHOLDER
mydomain = MAIL_DOMAIN_PLACEHOLDER
myorigin = $mydomain
mydestination = localhost
mynetworks = 127.0.0.1/32 [::1]/128

# Virtual domains/mailboxes/aliases via PostgreSQL
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql-virtual-domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql-virtual-mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql-virtual-aliases.cf
virtual_transport = lmtp:inet:dovecot:24
virtual_mailbox_base = /var/vmail

# Virtual mailbox ownership
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_minimum_uid = 5000

# TLS – Inbound
smtpd_tls_cert_file = /etc/ssl/mail/mail.crt
smtpd_tls_key_file = /etc/ssl/mail/mail.key
smtpd_tls_dh1024_param_file = /etc/ssl/mail/dhparams.pem
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = medium
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_session_cache_timeout = 3600s
smtpd_tls_fingerprint_digest = sha256
relay_clientcerts = hash:/etc/postfix/relay_clientcerts

# TLS – Outbound
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_protocols = >=TLSv1.2
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# SASL Authentication via Dovecot
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql-virtual-senders.cf
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = no
smtpd_tls_auth_only = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $mydomain
broken_sasl_auth_clients = yes

# Restrictions – HELO
smtpd_helo_required = yes
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname

# Restrictions – Sender
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# Restrictions – Recipient (NO OPEN RELAY)
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain

# Restrictions – Relay
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# Rspamd milter
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = inet:rspamd:11332
milter_protocol = 6
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# Rate limiting
smtpd_client_message_rate_limit = 100
smtpd_client_recipient_rate_limit = 500
anvil_rate_time_unit = 60s

# Message size limit (25MB)
message_size_limit = 26214400
mailbox_size_limit = 0

# Bounce handling
bounce_queue_lifetime = 1d
maximal_queue_lifetime = 3d
double_bounce_sender = double-bounce

# Performance
default_process_limit = 100
smtpd_client_connection_count_limit = 50
