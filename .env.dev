# =============================================================================
# FreeMailo – Development Environment Variables
# Usage:  docker compose --env-file .env.dev up -d
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=freemailo
POSTGRES_USER=freemailo
POSTGRES_PASSWORD=freemailo_dev_password
DATABASE_URL=postgresql://freemailo:freemailo_dev_password@postgres:5432/freemailo

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# --- Mail Server -------------------------------------------------------------
MAIL_HOSTNAME=mail.example.test
MAIL_DOMAIN=example.test
DOVECOT_MASTER_USER=freemailo_master
DOVECOT_MASTER_PASSWORD=freemailo_master_secret_2026

# --- Webmail & CORS / CSRF Allowed Origins -----------------------------------
# Primary public URL of the webmail application
APP_URL=http://localhost:3000
# Dedicated allowed frontend origins for CORS and CSRF (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Rspamd ------------------------------------------------------------------
RSPAMD_PASSWORD=rspamd_dev_password

# --- JWT / Auth ---------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_at_least_32_chars_long_ok
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Admin Seed Account ------------------------------------------------------
ADMIN_EMAIL=admin@freemailo.local
ADMIN_PASSWORD=admin123456

# --- Virtual Mail -------------------------------------------------------------
VMAIL_UID=5000
VMAIL_GID=5000
MESSAGE_SIZE_LIMIT=26214400

# Local self-signed mail certificate only
MAIL_TLS_REJECT_UNAUTHORIZED=false
COOKIE_SECURE=false
